// Reference PerfSentinelHub configuration, with every setting annotated.
//
// This file is the inventory, not a starting point. Every key outside Sources
// and the lists under Access carries the value the Hub already uses, so
// copying those lines changes nothing. Sources is the exception: it has no
// default, the Hub refuses to start without one, and the entry below is an
// example rather than a value to keep. The Access lists are empty by default
// and their entries are examples too. Take the lines you want. A test keeps this file exhaustive, so a
// setting that exists in the code and is missing here fails the build.
//
// The .NET JSON configuration provider tolerates these comments. It also
// ignores a key it does not recognise, in silence, which is why this file
// exists: a name recalled from memory produces no error and reads like a bug
// in the Hub rather than a typo in your config.
//
// Three surfaces carry the same settings. Environment variables use
// `Hub__Analysis__Workers=4`, doubled underscores for the colons. Helm uses
// `hub.analysis.workers` in values.yaml. See docs/CONFIGURATION.md.
{
  "Hub": {
    // Absolute path to the SQLite file. One writer, WAL, so one replica.
    "DatabasePath": "/data/hub.db",

    // How often the Hub polls each daemon. This governs the SUCCESS path only:
    // a failed poll retries on a bounded exponential backoff instead, so an
    // unreachable source is retried far more often than once an hour.
    "PollInterval": "01:00:00",

    // Per-request timeout for everything the Hub fetches from a source.
    "HttpTimeout": "00:00:10",

    // Daemons polled at once. 1 to 32.
    "MaxConcurrentPolls": 4,

    // How long a finding survives after its last observation. This is the one
    // clock that removes findings: a poll that omits one does not resolve it,
    // the daemon's ring buffer may simply have evicted it.
    "Retention": "180.00:00:00",

    // How long a finding stays `active` after its last sighting before it can
    // read as `likely_resolved`. Must be shorter than Retention.
    "ResolutionGrace": "7.00:00:00",

    // A daemon that first sees more signatures than this in an hour is flagged
    // on /api/sources and logged once. 0 turns the check off.
    "NewSignaturesPerHourWarning": 1000,

    // Page size for /api/findings when the caller names none, and the ceiling
    // it may ask for. MaxReadLimit is itself capped at 10000.
    "DefaultReadLimit": 1000,
    "MaxReadLimit": 10000,

    // The one port /metrics answers on, and nothing else answers there. Unset,
    // /metrics answers on every port. The Hub must also listen on it, besides
    // its main port (ASPNETCORE_HTTP_PORTS="8080;9464"), or it stops at startup.
    // Required with Access:Enabled. 1 to 65535.
    "MetricsPort": null,

    "Analysis": {
      // Absolute path to the perf-sentinel binary. Absent means analysis runs
      // are unavailable and the launcher says so, rather than failing a run.
      "EngineBinaryPath": null,

      // Where rendered reports are written. Also the working directory both
      // engine invocations run from, so a stray .perf-sentinel.toml beside
      // whatever launched the Hub cannot decide detection thresholds.
      "ReportDirectory": "/data/reports",

      // Header a reverse proxy sets with the requester's identity. Without
      // Hub:Auth the Hub authenticates nobody and records what the proxy
      // asserts. With it, the signed-in user wins and this header is ignored.
      "IdentityHeader": "X-Forwarded-User",

      // Concurrent runs. 1 to 16. Each one is a subprocess reading a backend.
      "Workers": 2,

      // Ceiling on the --max-traces a request may ask for. 1 to 10000.
      "MaxTracesCap": 2000,

      // Span trees embedded in the rendered report. Passing it at all opts the
      // sink out of size targeting, which is why it is set: without it a wide
      // sweep loses findings to the 5 MiB budget, and the finding list is what
      // an operator came for. The trees get capped instead. 0 to 10000.
      "MaxTracesEmbedded": 50,

      // Wall-clock ceiling on one run. Positive, at most one hour.
      "Timeout": "00:05:00",

      // Memory the container must still have free, in MiB, for a run to start
      // the engine inside it. Below it the run fails with hub_memory_low rather
      // than get the Hub OOM-killed. 0 to 65536, 0 turning the check off.
      "MinFreeMemoryMiB": 256,

      // How long a rendered report file survives. The run is then marked
      // expired and keeps its parameters, so it can be relaunched as it stands.
      // A link shared yesterday is already dead: this is not an audit trail.
      "ReportRetention": "1.00:00:00",

      // How long a finished run's row survives. Longer than ReportRetention on
      // purpose, since an expired run outlives the report it produced. A run
      // still pending or running is never purged, however old its row looks.
      "RunRetention": "30.00:00:00"
    },

    "UpdateCheck": {
      // Whether the Hub asks GitHub once a day for the newest published
      // release of the engine and of itself, so the version chip can say that
      // what runs here is no longer current. This is the ONLY outbound
      // destination the Hub has that is not a configured source. The request
      // is an unauthenticated GET carrying no identifier of your deployment.
      // Set false for a deployment with no egress: the chip then shows nothing
      // rather than claiming you are current.
      "Enabled": true,

      // At least 15 minutes.
      "Interval": "1.00:00:00",

      // Absolute HTTPS, no credentials, no query, no fragment.
      "EngineEndpoint": "https://api.github.com/repos/Institut-du-Numerique-Responsable/perf-sentinel/releases/latest",
      "HubEndpoint": "https://api.github.com/repos/Institut-du-Numerique-Responsable/PerfSentinelHub/releases/latest"
    },

    "Auth": {
      // Browser sign-in against an OAuth2 provider, so no authenticating proxy
      // has to stand in front of the Hub. Off, the Hub authenticates nobody and
      // records the IdentityHeader a proxy asserts. On, every route needs a
      // session except the machine ones: /api/findings (unless Access:Enabled),
      // the import (its own key), /health and /metrics. The provider's redirect URI to declare is
      // https://<hub host>/auth/callback. See docs/AUTHENTICATION.md.
      "Enabled": false,

      // Absolute HTTPS (HTTP on loopback only), no credentials, no fragment.
      "AuthorizationEndpoint": null,
      "TokenEndpoint": null,
      "UserInformationEndpoint": null,

      // A confidential client. Supply the secret through a Secret rather than
      // this file: under Helm that is auth.clientSecretName and clientSecretKey.
      "ClientId": null,
      "ClientSecret": null,

      // Space-separated.
      "Scopes": "openid profile email",

      // The userinfo field recorded as the identity. A userinfo without it
      // fails the sign-in rather than opening a nameless session. A display
      // name: nothing is ever authorized on it.
      "IdentityClaim": "email",

      // The userinfo field shown as an action's owner when the provider sends it. Ignored
      // when blank, over 128 characters or not a string. Never used for access.
      "DisplayNameClaim": "name",

      // The userinfo field holding the authorization key, read only with
      // Access:Enabled: sub, oid, uuid or account_id, ids a provider never
      // reassigns. Bitbucket Cloud has no sub: use account_id.
      "SubjectClaim": "sub",

      // The userinfo field listing the user's groups, read when RequiredGroups
      // is set or Access:Enabled.
      "GroupsClaim": "groups",

      // Empty lets in whoever the provider signs in. Otherwise a user must
      // belong to one of these, matched exactly as the provider spells them
      // (Keycloak's full group path reads "/hub-users"), and the session no
      // longer renews while in use: it ends 8 hours after sign-in. Requires
      // Enabled.
      "RequiredGroups": [],

      // CIDR networks whose X-Forwarded-For and X-Forwarded-Proto the Hub trusts:
      // the ingress controller's pods alone, one hop deep, never a range other
      // workloads share, since every listed address can forge the client
      // address. Empty trusts the scheme from any peer and the client address
      // from none, leaves terminal sign-in (perf-sentinel login) off and refuses
      // Access:LocalAccounts: behind a proxy every client would share its
      // address. A Hub with no proxy in front lists 127.0.0.1/32.
      "TrustedProxyNetworks": []
    },

    "AckRelay": {
      // Who acks has to be known, and a Hub:Auth session always says. Set true
      // to also accept the identity a reverse proxy puts in
      // Analysis:IdentityHeader, a claim the Hub cannot verify: only behind a
      // proxy that sets the header itself and strips the one a client sent.
      // With neither, the relay refuses every caller and the Hub says so at
      // startup.
      "TrustIdentityHeader": false
    },

    // Who reaches which findings, sources and runs. Off, nothing here is
    // validated or used, but it is still bound, so ExpiresAt must be an ISO 8601
    // date. Every entry below is an example, like Sources, and every list
    // defaults to empty. See docs/ACCESS-CONTROL.md.
    "Access": {
      // Requires Auth:Enabled, MetricsPort, and AckRelay:TrustIdentityHeader
      // false. On, every route but the import, /health and /metrics (on MetricsPort
      // only) needs a session or a machine token, and each caller reaches what its grants cover.
      "Enabled": false,

      // Subjects (the provider's immutable account id, never an email) holding
      // the built-in admin role on the whole Hub. The break-glass path when a
      // provider admin group breaks. Admins and AdminGroups are not both empty.
      "Admins": ["2f6d0c1e-8a4b-4e2f-9c71-0d3b5a6e7f81"],

      // Group references holding the admin role on the whole Hub: internal:<name>,
      // or a provider group spelled as the GroupsClaim field sends it. Name a
      // provider group only the organisation can create: a full path under its
      // own group. Where users create groups of any name (gitlab.com, GitLab by
      // default), a provider admin group is unsafe without Auth:RequiredGroups.
      "AdminGroups": ["/hub-admins", "internal:oncall", "internal:break-glass"],

      // Internal groups, referenced as internal:<Name>. Name: 1 to 64 ASCII
      // letters, digits, `.`, `_` or `-`, unique with case ignored. Members are
      // subjects, local:<name> for a local account. A group that backs a machine
      // token has no members.
      "Groups": [
        { "Name": "oncall", "Members": ["7c1e9a02-55d3-4b8e-a1f0-3e2d4c5b6a79"] },
        { "Name": "ci-shop", "Members": [] },
        { "Name": "break-glass", "Members": ["local:ops"] }
      ],

      // A project is a set of patterns; a record is in it when one pattern
      // matches. Each pattern sets one or more of Source (a source id), Service
      // and Attribute (key=value, split on the first `=`). A part is exact, or a
      // prefix ending in one `*`; a bare `*` is refused. Attribute keys are the
      // ones the daemons list in [detection] grouping_attributes.
      "Projects": [
        {
          "Name": "shop",
          "Patterns": [{ "Source": "checkout-prod", "Service": "cart*", "Attribute": "team=shop" }]
        }
      ],

      // Configured roles, beside the built-in reader (findings.read,
      // traces.read, analyses.run), member (reader plus acks.write,
      // actions.write and labels.write) and admin (all eleven, on `*` only).
      // Permissions are findings.read, traces.read, sources.read, analyses.run,
      // acks.write, actions.write, labels.write, disclosures.read,
      // disclosures.manage and recaps.read
      // (the last three apply to the whole Hub, granted on `*` only);
      // access.admin is held only through Admins, AdminGroups or the admin role.
      "Roles": [
        { "Name": "auditor", "Permissions": ["findings.read", "traces.read"] },
        // What a machine token's group gets: findings.read alone, one per team.
        { "Name": "ci-reader", "Permissions": ["findings.read"] }
      ],

      // Group gets Role on Project, a declared project or `*`, which also covers
      // records no project matches.
      "Grants": [
        { "Group": "/teams/shop-admin", "Project": "shop", "Role": "member" },
        { "Group": "internal:ci-shop", "Project": "shop", "Role": "ci-reader" }
      ],

      // Credentials for CI jobs and dashboards, holding findings.read at most.
      // Name: ^[a-z0-9][a-z0-9._-]{0,63}$. Group: an internal group with no
      // members. Token: 32 to 512 characters of the RFC 6750 b64token alphabet,
      // not starting with pshub_, supplied through a Secret rather than this
      // file. ExpiresAt: at most 365 days ahead.
      "MachineTokens": [
        { "Name": "ci-shop", "Group": "internal:ci-shop", "Token": null, "ExpiresAt": "2027-06-30T00:00:00Z" }
      ],

      // Break-glass accounts for when the provider is down. Declaring one puts the
      // Hub's own sign-in page in front of single sign-on. Each signs in as
      // local:<Name>, which Admins or a group's Members must list, for a fixed 8
      // hours, whatever Auth:RequiredGroups says. Name: ^[a-z0-9][a-z0-9._-]{0,63}$.
      // PasswordHash: the line `PerfSentinelHub hash-password` prints, supplied
      // through a Secret rather than this file; a new one ends the account's
      // sessions at the restart. Requires Auth:TrustedProxyNetworks.
      "LocalAccounts": [
        { "Name": "ops", "PasswordHash": null }
      ]
    },

    // The review recap. MovementThreshold: above 0, at most 10, the share of
    // change past which a finding reads up or down. Retention: at least 32 days,
    // how long a stored report and its deliveries are kept. MaxDelay: above zero,
    // at most 7 days, how long a report waits for the ledgers to seal its last
    // day. PublicUrl: the Hub's root as a reader reaches it, for the engineering
    // link, else Disclosures:PublicUrl. Webhooks: the disclosure webhook shape,
    // where IncludeShareLink and ShareLinkDays apply to disclosures only and
    // Confidentiality stays public. Smtp: the relay each e-mail is handed to, off
    // while Host is null; Port 587 with StartTls, never 465; Password through a
    // Secret. Subscriptions: Cadences (day, week, month) and Views (pilotage,
    // tech), a scope (Environment, SourceId, Service, Grouping, all optional)
    // and the Webhooks names and Emails addresses that receive each report.
    // See docs/CONFIGURATION.md.
    "Recaps": {
      "MovementThreshold": 0.2,
      "Retention": "365.00:00:00",
      "MaxDelay": "06:00:00",
      "PublicUrl": null,
      "Webhooks": [
        {
          "Name": "ops-chat",
          "Url": null,
          "Secret": null,
          "Confidentiality": "public",
          "IncludeShareLink": false,
          "ShareLinkDays": 7
        }
      ],
      "Smtp": {
        "Host": null,
        "Port": 587,
        "StartTls": true,
        "UserName": null,
        "Password": null,
        "From": null
      },
      "Subscriptions": [
        {
          "Name": "weekly-shop",
          "Cadences": ["week"],
          "Views": ["pilotage", "tech"],
          "Environment": null,
          "SourceId": null,
          "Service": null,
          "Grouping": null,
          "Webhooks": [],
          "Emails": []
        }
      ]
    },

    // Periodic disclosures a scheduled job publishes to POST /api/import/disclosures. Off
    // while ImportKey is null: the route, the Disclosures screen, the share
    // links and the webhooks then all answer 404 or stay hidden. ImportKey: 32+
    // characters, supplied through a Secret, distinct from every source import
    // key and machine token. AllowInternal needs Access:Enabled. ExpectedIdentity
    // and ExpectedIssuer go together, printed in the PDF's verify command for
    // the reader, who checks the signature: the Hub never does. ShareLinkDays: 1 to 30. See docs/CONFIGURATION.md.
    "Disclosures": {
      "ImportKey": null,
      "AllowInternal": false,
      "ExpectedIdentity": null,
      "ExpectedIssuer": null,
      "ShareLinkDays": 7,

      // The Hub's own address as a receiver reaches it, for the share link a
      // webhook with IncludeShareLink sends. Required by such a webhook.
      "PublicUrl": null,

      // An example. Url: https, or http to loopback, never stored nor shown.
      // Secret: 32+ characters, through a Secret. Confidentiality: public only.
      "Webhooks": [
        {
          "Name": "auditors",
          "Url": null,
          "Secret": null,
          "Confidentiality": "public",
          "IncludeShareLink": false,
          "ShareLinkDays": 7
        }
      ]
    },

    // Configuration, never discovery. Nothing is auto-detected, the launcher
    // cannot add a source, and the Hub refuses to start with none. Id, Name,
    // Environment, Kind, BaseUrl, PublicUrl and RetentionHours are declared and never
    // checked against anything, which is why a misconfigured deployment can
    // label production as staging and nothing will contradict it.
    "Sources": [
      {
        // Unique. 1 to 64 ASCII letters, digits, `.`, `_` or `-`. It becomes a
        // Prometheus label, which is why the character set is closed.
        "Id": "checkout-prod",
        "Name": "Checkout production",
        "Environment": "production",

        // daemon, tempo, or jaeger_query. Only a daemon is polled, and only a
        // daemon may carry an import key. Victoria Traces speaks the Jaeger
        // query API, so it is jaeger_query.
        "Kind": "daemon",

        // Required. Absolute HTTP(S), no credentials, query or fragment. A path
        // prefix is kept, so https://gw/perf-sentinel/ polls
        // https://gw/perf-sentinel/api/status.
        "BaseUrl": "http://perf-sentinel.observability:4318",

        // Optional, same shape as BaseUrl. Where a workstation or a viewer's
        // browser reaches this source, when the Hub reads a name only the
        // cluster resolves. Printed commands and live reports use it, the
        // Hub's own reads and runs keep BaseUrl. Absent, both use BaseUrl.
        "PublicUrl": null,

        // Trace backends only. 1 hour to 10 years. Declared rather than
        // measured, no backend API exposes it, so it keeps a stale claim until
        // someone edits it.
        "RetentionHours": null,

        // Both absent or both present, no newlines.
        "AuthHeaderName": null,
        "AuthHeaderValue": null,

        // Requires PublicUrl. The header the public route asks for, when it is
        // not AuthHeaderName, as an Ingress that authenticates on its own
        // terms. A name only: printed commands tell the reader to supply the
        // value, the Hub never calls that route. Absent, they name
        // AuthHeaderName.
        "PublicAuthHeaderName": null,

        // Daemons only. Both absent or both present, no newlines. What the Hub
        // sends when it relays an ack or a revoke: the daemon's [daemon.ack]
        // api_key, as X-API-Key. Never the read key above, which the daemon
        // refuses on a write, so the value must differ from AuthHeaderValue.
        // Absent, the Hub never writes to this daemon. Supply the value through
        // a Secret: under Helm that is ackSecretName and ackSecretKey.
        "AckHeaderName": null,
        "AckHeaderValue": null,

        // Fills a report's pg_stat tab from a Prometheus the engine scrapes at
        // render time, each key the report flag of the same name, see
        // CONFIGURATION.md. Without Prometheus the whole object is left out
        // and the tab stays empty. Selector takes label matchers such as
        // namespace="shop",db_role="primary". AuthHeaderValue belongs in a
        // Secret: under Helm, pgStat.authSecretName and pgStat.authSecretKey.
        "PgStat": {
          "Prometheus": null,
          "Metric": null,
          "QueryLabel": null,
          "CallsMetric": null,
          "Unit": null,
          "Selector": null,
          "Top": null,
          "AuthHeaderName": null,
          "AuthHeaderValue": null
        },

        // The same keys for the mysql_stat tab.
        "MySqlStat": {
          "Prometheus": null,
          "Metric": null,
          "QueryLabel": null,
          "CallsMetric": null,
          "Unit": null,
          "Selector": null,
          "Top": null,
          "AuthHeaderName": null,
          "AuthHeaderValue": null
        },

        // The daemon's push credential, at least 32 characters. Supply it
        // through a Secret rather than this file: under Helm that is
        // importSecretName and importSecretKey, never an inline value.
        "ImportApiKey": null
      }
    ]
  }
}
